---
import '@fontsource-variable/manrope';
import '../styles/global.css';

const { title, description, extraJsonLd = null } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'David Bennett',
  honorificSuffix: 'Ph.D.',
  jobTitle: 'MRI physicist and imaging scientist',
  url: 'https://davidbennettphd.com',
  sameAs: ['https://www.linkedin.com/in/david-bennett-phd-imaging-scientist', 'https://github.com/daveb08'],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Worcester Polytechnic Institute' },
    { '@type': 'CollegeOrUniversity', name: 'University of Massachusetts Lowell' },
  ],
  knowsAbout: ['MRI physics', 'Imaging biomarkers', 'Imaging endpoints in clinical trials', 'MR elastography', 'Physics education', 'Educational simulation'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://davidbennettphd.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {extraJsonLd && <script type="application/ld+json" set:html={JSON.stringify(extraJsonLd)} />}
  </head>
  <body>
    <a href="#top" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-bg">Skip to content</a>
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
