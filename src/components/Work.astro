---
import work from '../data/work.js';
const {
  limit = work.length,
  heading = 'Work that moved trials forward',
  lede = 'Six projects, from the regulatory strategy behind a Phase 3 endpoint down to the hardware inside the scanner.',
  more = null,
} = Astro.props;
---
<section id="work">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2>{heading}</h2>
      <p class="lede">{lede}</p>
    </div>
    <ul class="rows">
      {work.slice(0, limit).map((w) => (
        <li class="reveal"><span class="mono">{w.when}</span>
          <h3>{w.title}</h3>
          <p>{w.text}</p></li>
      ))}
    </ul>
    {more && <p class="more"><a class="go" href={more.href}>{more.label}</a></p>}
  </div>
</section>
