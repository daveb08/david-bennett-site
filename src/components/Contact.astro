---
// Cloudflare Turnstile site key (public; the secret key lives only in the Worker's settings).
const SITEKEY = '0x4AAAAAAGGAHjUKdcE9hnZ5';
---
<section class="contact" id="contact">
  <div class="wrap">
    <h2 class="reveal">Hire me, book me, or just ask.</h2>
    <p class="lede">Tell me what you need: an imaging endpoint, a physics course, or a talk.</p>
    <form class="cform" id="cform" novalidate data-sitekey={SITEKEY}>
      <div class="row2">
        <label>Name<input name="name" autocomplete="name" required maxlength="120"></label>
        <label>Email<input name="email" type="email" autocomplete="email" required maxlength="200"></label>
      </div>
      <label>What is this about?
        <select name="topic" id="ctopic">
          <option value="role">A role or consulting project</option>
          <option value="teaching">A course or teaching</option>
          <option value="talk">A talk or workshop</option>
          <option value="other">Something else</option>
        </select>
      </label>
      <label>Message<textarea name="message" rows="6" required maxlength="5000"></textarea></label>
      <label class="hp" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off"></label>
      <div class="ts" id="cts"></div>
      <div class="send">
        <button class="pill" type="submit" id="csend">Send message</button>
        <p class="cstatus" id="cstatus" role="status" aria-live="polite"></p>
      </div>
    </form>
    <p class="orline mono">Or email me directly</p>
    <div class="mailrow">
      <a class="bigmail" href="mailto:dave@davidbennettphd.com">dave@davidbennettphd.com</a>
      <button class="copyico" type="button" id="copymail" aria-label="Copy email address"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="c1" d="M9 9h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V10a1 1 0 0 1 1-1zm1 2v8h8v-8h-8zM5 3h10a1 1 0 0 1 1 1v2h-2V5H6v8h1v2H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path class="c2" d="M9.5 16.2 5.8 12.5l-1.4 1.4 5.1 5.1L20 8.5l-1.4-1.4z"/></svg><span id="copymsg" aria-live="polite">Copy email address</span></button>
    </div>
    <div class="cta">
      <a class="pill ico" href="David-Bennett-CV.pdf" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 3h2v10.2l3.6-3.6L18 11l-6 6-6-6 1.4-1.4 3.6 3.6V3zM5 19h14v2H5v-2z"/></svg>Download CV</a>
    </div>
    <div class="social">
      <a class="ico2" href="https://www.linkedin.com/in/david-bennett-phd-imaging-scientist" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>LinkedIn</a>
      <a class="ico2" href="https://github.com/daveb08" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>GitHub</a>
    </div>
    <div class="foot mono"><span>© 2026 David Bennett, Ph.D.</span><span>Methuen, Massachusetts</span></div>
  </div>
</section>
