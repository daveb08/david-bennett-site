---
import events from '../data/timeline.js';
const label = { s: 'Science and engineering', t: 'Teaching' };
---
<div class="tl" id="tl">
  <div class="tl-spine"><div class="tl-fill" id="tl-fill"></div></div>
  <div class="tl-heads"><span class="c-signal">{label.s}</span><span class="c-teal">{label.t}</span></div>
  {events.map((e) => (
    <div class={`ev ${e.track} on`}>
      <div class="when"><i class="node"></i><b>{e.start}</b>{e.span && <small>{e.span}</small>}</div>
      <div class="body">
        <span class="mono tag">{label[e.track]}</span>
        <h3>{e.title}</h3>
        <span class="mono org">{e.org}</span>
        <p>{e.text}</p>
      </div>
    </div>
  ))}
</div>
