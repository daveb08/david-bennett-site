---
// current: which page is open ('consulting' | 'teaching' | 'simulators'), for aria-current.
const { current = '' } = Astro.props;
const links = [
  { key: 'consulting', href: '/consulting/', label: 'Consulting' },
  { key: 'teaching', href: '/teaching/', label: 'Teaching' },
  { key: 'simulators', href: '/simulators/', label: 'Simulators' },
  { key: 'articles', href: '/articles/', label: 'Articles' },
  { key: 'career', href: '/#career', label: 'Career' },
];
---
<header class="top">
  <div class="wrap">
    <a class="brand" href="/">David Bennett, Ph.D.</a>
    <nav aria-label="Main" id="nav">
      {links.map((l) => <a href={l.href} aria-current={l.key === current ? 'page' : undefined}>{l.label}</a>)}
      <a class="pill line" href="/David-Bennett-CV.pdf" target="_blank" rel="noopener">Download CV</a>
      <a class="pill" href="#contact">Get in touch</a>
    </nav>
    <button class="burger" type="button" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="nav"><i></i><i></i></button>
  </div>
</header>
